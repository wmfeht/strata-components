{
  "bullets": [
    "app/dialogs: Opening Settings fades its whole layer",
    "app/dialogs: The first Settings open of a process fades in",
    "app/dialogs: Closing Settings during its fade-in"
  ],
  "scene": "c15-openers-light",
  "events": [
    {
      "t": 0.1,
      "type": "tap",
